<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MorphingImageView">
        <attr name="fromIconAVD" format="integer"/>
        <attr name="toIconAVD" format="integer"/>
        <attr name="isColorChanging" format="boolean"/>
        <attr name="fromColor" format="color"/>
        <attr name="toColor" format="color"/>
    </declare-styleable>

    <declare-styleable name="IconToggleView">
        <attr name="firstIcon" format="integer"/>
        <attr name="secondIcon" format="integer"/>
        <attr name="firstIconColor" format="color"/>
        <attr name="secondIconColor" format="color"/>
    </declare-styleable>

    <declare-styleable name="Theme1">
        <attr name="backgroundColorPrimary" format="color"/>
        <attr name="textColorPrimary" format="color"/>
    </declare-styleable>
</resources>