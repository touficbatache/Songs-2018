<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.Translucent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="windowActionBarOverlay">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.Toolbar" parent="Theme.AppCompat.Light">
        <item name="colorPrimary">@color/white</item> <!-- Status Bar color below overlay -->
    </style>

    <style name="PlayerTheme" parent="AppTheme">
        <item name="colorPrimary">@color/player_action_other</item>

        <item name="android:background">@color/grey_e0</item>
        <item name="android:windowBackground">@color/grey_e0</item>
        <item name="android:colorBackground">@color/grey_e0</item>
    </style>
    
    <style name="ColorAccentWhite">
        <item name="colorAccent">@color/white</item>
    </style>

    <style name="Theme1" parent="AppTheme">
        <!--<item name="backgroundColorPrimary">@color/backgroundColorPrimary1</item>-->
        <!--<item name="textColorPrimary">@color/textColorPrimary1</item>-->
        <item name="backgroundColorPrimary">@color/grey_fa</item>
        <item name="textColorPrimary">@color/colorPrimary</item>
    </style>

    <style name="MaterialSearchViewStyle">
        <!-- Background for the search bar -->
        <item name="searchBackground">@color/white</item>

        <!-- Change icon for the suggestions -->
        <item name="searchSuggestionIcon">@drawable/ic_history_grey_24dp</item>

        <!-- Change background for the suggestions list view -->
        <item name="searchSuggestionBackground">@android:color/white</item>

        <!-- Change text color for edit text. This will also be the color of the cursor -->
        <item name="android:textColor">@color/black</item>

        <!-- Change hint text color for edit text -->
        <item name="android:textColorHint">@color/hint</item>

        <!-- Hint for edit text -->
        <item name="android:hint">@string/hint_search</item>
    </style>

</resources>
