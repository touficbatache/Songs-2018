<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.Songs" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondary</item>

        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorOnSurface">@color/colorOnBackground</item>
        <item name="android:textColor">@color/colorOnBackground</item>
        <item name="iconTint">@color/colorOnBackgroundHighEmphasis</item>
        <item name="colorBackgroundFloating">@color/colorBackground</item>
        <item name="android:colorBackgroundFloating" tools:targetApi="23">@color/colorBackground</item>

        <item name="actionOverflowButtonStyle">@style/Theme.Songs.OverFlow</item>
        <item name="homeAsUpIndicator">@drawable/ic_arrow_back_24dp</item>
        <!-- System bar attributes -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="M">?attr/isLightTheme</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="O_MR1">true</item>
        <!-- Shape attributes -->
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Songs.LargeComponent
        </item>
        <!-- Widget style attributes -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Songs.BottomSheetDialog</item>
    </style>

    <style name="Theme.Songs.OverFlow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_more_vert_24dp</item>
    </style>

    <style name="Widget.MaterialComponents.Toolbar.Background" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="android:background">?android:attr/windowBackground</item>
        <item name="titleTextColor">@color/material_on_background_emphasis_high_type</item>
        <item name="subtitleTextColor">@color/material_on_background_emphasis_medium</item>
        <!-- Note: this theme overlay will only work if the style is applied directly to a Toolbar. -->
        <item name="android:theme">@style/ThemeOverlay.MaterialComponents.Toolbar.Surface</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="colorPrimary">@color/white</item> <!-- App bar background color -->
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <style name="Theme.Songs.Player" parent="Theme.Songs">
        <item name="colorPrimary">@color/player_action_other</item>

<!--        <item name="android:background">@color/colorPlayerBackground</item>-->
<!--        <item name="android:windowBackground">@color/colorPlayerBackground</item>-->
<!--        <item name="android:colorBackground">@color/colorPlayerBackground</item>-->
    </style>

    <style name="ThemeOverlay.Songs.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="O_MR1">true</item>
    </style>

    <style name="ColorSecondaryWhite">
        <item name="colorSecondary">@color/white</item>
    </style>

    <style name="MaterialSearchViewStyle">
        <!-- Background for the searchYoutube bar -->
        <item name="searchBackground">@color/white</item>

        <!-- Change icon for the suggestions -->
        <item name="searchSuggestionIcon">@drawable/ic_history_grey_24dp</item>

        <!-- Change background for the suggestions list view -->
        <item name="searchSuggestionBackground">@android:color/white</item>

        <!-- Change text color for edit text. This will also be the color of the cursor -->
        <item name="android:textColor">@color/black</item>

        <!-- Change hint text color for edit text -->
        <item name="android:textColorHint">@color/hint</item>

        <!-- Hint for edit text -->
        <item name="android:hint">@string/hint_search</item>
    </style>

    <style name="RippleWhite" parent="ThemeOverlay.AppCompat">
        <item name="colorControlHighlight">@color/white</item>
    </style>

    <style name="ShapeAppearance.Songs.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Songs.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Songs.LargeComponent</item>
    </style>

    <style name="TextAppearance.Songs.Subheader" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
    </style>

</resources>
