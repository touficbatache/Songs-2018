<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp"
    android:theme="@style/PlayerTheme">

    <android.support.constraint.ConstraintLayout
        android:id="@+id/player_top_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/player_arrow_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:src="@drawable/ic_keyboard_arrow_down_24dp"
            android:tint="@color/grey_67"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/player_see_playing_queue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:src="@drawable/ic_queue_music_24dp"
            android:tint="@color/grey_67"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/player_next_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/player_arrow_down"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/roboto_medium"
                android:text="@string/next_up"
                android:textAllCaps="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/player_next_up_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@string/roboto_medium"
                android:singleLine="true"
                tools:text="Make It Look Easy" />

        </LinearLayout>

    </android.support.constraint.ConstraintLayout>

    <android.support.v7.widget.RecyclerView
        android:id="@+id/player_cover_arts_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/player_top_controls" />

    <TextView
        android:id="@+id/player_song_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:fontFamily="@string/roboto_medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingEnd="52dp"
        android:paddingStart="52dp"
        android:textAllCaps="true"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_cover_arts_recyclerview"
        tools:text="Song title" />

    <TextView
        android:id="@+id/player_song_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/roboto_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_song_title"
        tools:text="Song artist" />

    <ml.toufic.songs.views.MorphingImageView
        android:id="@+id/player_action_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitXY"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:fromIconAVD="@drawable/favorite_border_to_fill"
        app:toIconAVD="@drawable/favorite_fill_to_border"
        app:isColorChanging="true"
        app:toColor="@color/player_action_favorite"
        app:layout_constraintTop_toBottomOf="@id/player_song_artist"
        app:layout_constraintEnd_toStartOf="@id/player_action_cloud_download"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <ml.toufic.songs.views.CloudDownloadBorderToFillImageView
        android:id="@+id/player_action_cloud_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="36dp"
        android:scaleType="fitXY"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toBottomOf="@id/player_song_artist"
        app:layout_constraintEnd_toStartOf="@id/player_action_add_to_playlist"
        app:layout_constraintStart_toEndOf="@id/player_action_favorite"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <ml.toufic.songs.views.MorphingImageView
        android:id="@+id/player_action_add_to_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="36dp"
        android:scaleType="fitXY"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:fromIconAVD="@drawable/playlist_add_to_check"
        app:toIconAVD="@drawable/playlist_check_to_add"
        app:isColorChanging="true"
        app:toColor="@color/player_action_other"
        app:layout_constraintTop_toBottomOf="@id/player_song_artist"
        app:layout_constraintEnd_toStartOf="@id/player_action_share"
        app:layout_constraintStart_toEndOf="@id/player_action_cloud_download"
        app:layout_constraintHorizontal_chainStyle="packed"/>

    <ImageButton
        android:id="@+id/player_action_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="36dp"
        android:src="@drawable/ic_share_black_24dp"
        android:tint="@color/grey_c0"
        android:scaleType="fitXY"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toBottomOf="@id/player_song_artist"
        app:layout_constraintStart_toEndOf="@id/player_action_add_to_playlist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <SeekBar
        android:id="@+id/player_song_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:theme="@style/ColorAccentWhite"
        app:layout_constraintBottom_toTopOf="@id/player_repeat_btn"
        app:layout_constraintTop_toBottomOf="@+id/player_action_cloud_download" />

    <LinearLayout
        android:id="@+id/player_progress_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@id/player_repeat_btn"
        app:layout_constraintTop_toBottomOf="@id/player_song_progress">

        <TextView
            android:id="@+id/player_progress_current"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="00:00" />

        <TextView
            android:id="@+id/player_progress_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="04:47" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/player_repeat_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:tint="@color/grey_c0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_progress_text"
        app:srcCompat="@drawable/ic_repeat_24dp"
        tools:ignore="MissingPrefix" />

    <ImageButton
        android:id="@+id/player_prev_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="-8dp"
        android:layout_marginTop="24dp"
        android:layout_toStartOf="@+id/player_play_to_pause_btn"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:tint="@color/grey_67"
        app:layout_constraintEnd_toStartOf="@+id/player_play_to_pause_btn"
        app:layout_constraintTop_toBottomOf="@id/player_progress_text"
        app:srcCompat="@drawable/ic_skip_previous_24dp"
        tools:ignore="MissingPrefix" />

    <ml.toufic.songs.views.MorphingImageView
        android:id="@+id/player_play_to_pause_btn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_centerInParent="true"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/circle_white_ripple"
        android:clickable="true"
        android:elevation="4dp"
        android:padding="16dp"
        app:fromIconAVD="@drawable/play_to_pause"
        app:toIconAVD="@drawable/pause_to_play"
        app:layout_constraintBottom_toBottomOf="@+id/player_next_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/player_next_btn" />

    <ImageButton
        android:id="@+id/player_next_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="24dp"
        android:layout_toEndOf="@+id/player_play_to_pause_btn"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:tint="@color/grey_67"
        app:layout_constraintStart_toEndOf="@+id/player_play_to_pause_btn"
        app:layout_constraintTop_toBottomOf="@id/player_progress_text"
        app:srcCompat="@drawable/ic_skip_next_24dp"
        tools:ignore="MissingPrefix" />

    <ImageButton
        android:id="@+id/player_shuffle_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:tint="@color/grey_c0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_progress_text"
        app:srcCompat="@drawable/ic_shuffle_24dp"
        tools:ignore="MissingPrefix" />

</android.support.constraint.ConstraintLayout>