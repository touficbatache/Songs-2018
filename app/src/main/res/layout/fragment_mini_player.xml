<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <me.zhanghai.android.materialprogressbar.MaterialProgressBar
        android:id="@+id/mini_player_song_progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        app:mpb_progressStyle="horizontal"
        app:mpb_useIntrinsicPadding="false"
        app:mpb_progressBackgroundTint="@color/grey_fa"
        style="@style/Widget.MaterialProgressBar.ProgressBar.Horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/mini_player_height"
        android:background="?android:colorBackground">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/mini_player_arrow_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                app:srcCompat="@drawable/ic_keyboard_arrow_up_24dp"
                android:tint="?attr/colorOnBackground" />

            <TextView
                android:id="@+id/mini_player_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:padding="16dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Song name" />

        </LinearLayout>

        <com.batache.songs.ui.view.MorphingImageView
            android:id="@+id/mini_player_play_to_pause_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            app:fromIconAVD="@drawable/play_to_pause"
            app:toIconAVD="@drawable/pause_to_play" />

    </LinearLayout>

</LinearLayout>