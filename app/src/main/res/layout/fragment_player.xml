<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Songs.Player">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_top_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/player_arrow_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:tint="?attr/colorOnBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_keyboard_arrow_down_24dp" />

        <ImageButton
            android:id="@+id/player_see_playing_queue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:tint="?attr/colorOnBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_queue_music_24dp" />

        <LinearLayout
            android:id="@+id/player_next_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/player_arrow_down"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@string/roboto_medium"
                android:text="@string/next_up"
                android:textAllCaps="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/player_next_up_song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@string/roboto_medium"
                android:singleLine="true"
                tools:text="Make It Look Easy" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.airbnb.epoxy.EpoxyRecyclerView
        android:id="@+id/player_cover_arts_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/player_top_controls" />

    <TextView
        android:id="@+id/player_song_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@string/roboto_medium"
        android:maxLines="1"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:textAllCaps="true"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/player_action_favorite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_cover_arts_recyclerview"
        tools:text="Song title" />

    <TextView
        android:id="@+id/player_song_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/roboto_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_song_title"
        tools:text="Song artist" />

    <com.batache.songs.ui.view.IconToggleView
        android:id="@+id/player_action_favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:padding="8dp"
        android:scaleType="fitXY"
        app:firstIcon="@drawable/ic_favorite_outlined_black_24dp"
        app:layout_constraintBottom_toTopOf="@id/player_song_progress"
        app:layout_constraintEnd_toStartOf="@id/player_action_cloud_download"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_song_artist"
        app:secondIcon="@drawable/ic_favorite_24dp"
        app:secondIconColor="@color/player_action_favorite" />

    <me.zhanghai.android.materialprogressbar.MaterialProgressBar
        android:id="@+id/player_download_progress"
        style="@style/Widget.MaterialProgressBar.ProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@id/player_action_cloud_download"
        app:layout_constraintEnd_toEndOf="@id/player_action_cloud_download"
        app:layout_constraintStart_toStartOf="@id/player_action_cloud_download"
        app:layout_constraintTop_toTopOf="@id/player_action_cloud_download"
        app:mpb_progressStyle="circular"
        app:mpb_progressTint="?attr/colorPrimary" />

    <com.batache.songs.ui.view.CloudDownloadBorderToFillImageView
        android:id="@+id/player_action_cloud_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="36dp"
        android:layout_marginLeft="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:padding="8dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@id/player_song_progress"
        app:layout_constraintEnd_toStartOf="@id/player_action_add_to_playlist"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/player_action_favorite"
        app:layout_constraintTop_toBottomOf="@id/player_song_artist" />

    <com.batache.songs.ui.view.IconToggleView
        android:id="@+id/player_action_add_to_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginLeft="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:padding="8dp"
        android:scaleType="fitXY"
        app:firstIcon="@drawable/ic_playlist_add_24dp"
        app:firstIconColor="@color/grey_67"
        app:layout_constraintBottom_toTopOf="@id/player_song_progress"
        app:layout_constraintEnd_toStartOf="@id/player_action_share"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/player_action_cloud_download"
        app:layout_constraintTop_toBottomOf="@id/player_song_artist"
        app:secondIcon="@drawable/ic_playlist_add_check_24dp"
        app:secondIconColor="?attr/colorPrimary" />

    <ImageButton
        android:id="@+id/player_action_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginLeft="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@id/player_song_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/player_action_add_to_playlist"
        app:layout_constraintTop_toBottomOf="@id/player_song_artist"
        app:srcCompat="@drawable/ic_share_black_24dp"
        app:tint="?attr/colorOnBackground" />

    <SeekBar
        android:id="@+id/player_song_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:clickable="true"
        android:theme="@style/ColorSecondaryWhite"
        app:layout_constraintBottom_toTopOf="@id/player_repeat_btn"
        app:layout_constraintTop_toBottomOf="@id/player_action_favorite" />

    <TextView
        android:id="@+id/player_progress_current"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="@id/player_song_progress"
        app:layout_constraintTop_toBottomOf="@id/player_song_progress"
        tools:text="00:00" />

    <TextView
        android:id="@+id/player_progress_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="@id/player_song_progress"
        app:layout_constraintTop_toBottomOf="@id/player_song_progress"
        tools:text="04:47" />

    <com.batache.songs.ui.view.RepeatToggleView
        android:id="@+id/player_repeat_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:padding="22dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_repeat_24dp"
        tools:ignore="MissingPrefix" />

    <ImageButton
        android:id="@+id/player_prev_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:tint="?attr/colorOnBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/player_play_to_pause_btn"
        app:srcCompat="@drawable/ic_skip_previous_24dp"
        tools:ignore="MissingPrefix" />

    <com.batache.songs.ui.view.MorphingImageView
        android:id="@+id/player_play_to_pause_btn"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_centerInParent="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/circle_white_ripple"
        android:clickable="true"
        android:elevation="4dp"
        android:padding="16dp"
        app:fromIconAVD="@drawable/play_to_pause"
        app:layout_constraintBottom_toBottomOf="@+id/player_next_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/player_next_btn"
        app:toIconAVD="@drawable/pause_to_play" />

    <ImageButton
        android:id="@+id/player_next_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:tint="?attr/colorOnBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/player_play_to_pause_btn"
        app:srcCompat="@drawable/ic_skip_next_24dp"
        tools:ignore="MissingPrefix" />

    <ImageButton
        android:id="@+id/player_shuffle_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:tint="@color/grey_c0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_shuffle_24dp"
        tools:ignore="MissingPrefix" />

</androidx.constraintlayout.widget.ConstraintLayout>