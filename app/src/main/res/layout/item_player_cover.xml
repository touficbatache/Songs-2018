<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:fresco="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@color/transparent">

        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/player_cover_background_disc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="46dp"
            android:layout_marginEnd="46dp"
            fresco:viewAspectRatio="1"
            fresco:actualImageResource="@drawable/disk_background"
            fresco:placeholderImageScaleType="fitCenter"
            fresco:layout_constraintTop_toTopOf="parent"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintEnd_toEndOf="parent"/>

        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/player_song_cover_art"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            fresco:layout_constraintTop_toTopOf="parent"
            fresco:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="120dp"
            android:layout_marginEnd="120dp"
            android:background="@color/transparent"
            fresco:viewAspectRatio="1"
            fresco:placeholderImageScaleType="fitCenter"
            fresco:roundAsCircle="true" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/circle_grey_grey_e0"
            android:background="@color/transparent"
            fresco:layout_constraintTop_toTopOf="parent"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/player_song_lyrics"
            android:layout_width="0dp"
            android:layout_height="0dp"
            fresco:layout_constraintBottom_toBottomOf="@+id/player_cover_background_disc"
            fresco:layout_constraintTop_toTopOf="@+id/player_cover_background_disc"
            fresco:layout_constraintStart_toStartOf="@+id/player_cover_background_disc"
            fresco:layout_constraintEnd_toEndOf="@+id/player_cover_background_disc"
            android:background="@color/transparent"
            android:scrollbars="vertical"
            android:textColor="@color/white"
            android:textStyle="bold" />

    </android.support.constraint.ConstraintLayout>

</RelativeLayout>