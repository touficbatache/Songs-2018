<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="36dp"
    android:paddingEnd="36dp">

    <!--mar: 120dp-->
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/player_song_cover_art"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        fresco:layout_constraintTop_toTopOf="parent"
        fresco:placeholderImageScaleType="fitCenter"
        fresco:roundedCornerRadius="12dp"
        fresco:viewAspectRatio="1" />

    <Space
        android:id="@+id/left_negative_margin"
        android:layout_width="160dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Space
        android:id="@+id/right_negative_margin"
        android:layout_width="160dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/seek_previous"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="70dp"
        android:layout_marginRight="70dp"
        android:alpha="0"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical|end"
        android:orientation="vertical"
        android:theme="@style/RippleWhite"
        app:layout_constraintBottom_toBottomOf="@id/player_song_cover_art"
        app:layout_constraintEnd_toStartOf="@id/seek_next"
        app:layout_constraintStart_toStartOf="@id/left_negative_margin"
        app:layout_constraintTop_toTopOf="@id/player_song_cover_art">

        <LinearLayout
            android:id="@+id/seek_previous_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tint="@color/white"
                app:srcCompat="@drawable/ic_skip_previous_24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:text="10 seconds"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/seek_next"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="70dp"
        android:layout_marginLeft="70dp"
        android:alpha="0"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        android:theme="@style/RippleWhite"
        app:layout_constraintBottom_toBottomOf="@id/player_song_cover_art"
        app:layout_constraintEnd_toEndOf="@id/right_negative_margin"
        app:layout_constraintStart_toEndOf="@id/seek_previous"
        app:layout_constraintTop_toTopOf="@id/player_song_cover_art">

        <LinearLayout
            android:id="@+id/seek_next_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:tint="@color/white"
                app:srcCompat="@drawable/ic_skip_next_24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:text="10 seconds"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/lyrics_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        app:backgroundTint="@color/white"
        app:layout_constraintStart_toStartOf="@id/player_song_cover_art"
        app:layout_constraintTop_toTopOf="@id/player_song_cover_art"
        app:srcCompat="@drawable/ic_filter_list_24dp"
        app:tint="@color/colorSecondary" />

</androidx.constraintlayout.widget.ConstraintLayout>