<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mini_player_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mini_player_height"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/mini_player_arrow_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:src="@drawable/ic_keyboard_arrow_up_black_24dp"
            android:tint="@color/grey_67" />

        <TextView
            android:id="@+id/mini_player_song_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:padding="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Song name" />

    </LinearLayout>

    <ml.toufic.songs.views.PlayToPauseMorphingImageView
        android:id="@+id/mini_player_play_to_pause_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp" />

</LinearLayout>